# ---- LLM (required) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- LangSmith tracing (optional but recommended) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-task-assistant
# In production, trace a sample to stay inside the plan's included traces (see DECISIONS.md), e.g. 0.15
# LANGSMITH_TRACING_SAMPLING_RATE=1
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU workspaces

# ---- Database ----
# MongoDB connection string (e.g. from MongoDB Atlas → Connect → Drivers), required.
# Collections are created and the six employees seeded automatically on first request.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smart_task_assistant

# ---- Telegram demo bot (optional, `pnpm telegram`) ----
TELEGRAM_BOT_TOKEN=

# ---- Demo helpers ----
# Enables POST /api/reset (wipes tasks) used by the demo UI. Never enable in production.
ENABLE_DEMO_RESET=true
# Pin "today" for reproducible runs, ISO in Asia/Riyadh, e.g. 2026-10-13T09:00:00. Leave empty to use the real clock.
APP_NOW=
