{
  "name": "smart-task-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "مساعد المهام الذكي — Arabic task assistant built with Next.js, LangGraph and LangSmith",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:reset": "tsx scripts/db-reset.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "eval": "tsx scripts/eval-langsmith.ts",
    "telegram": "tsx scripts/telegram-bot.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "langsmith": "^0.10.12",
    "luxon": "^3.7.2",
    "mongodb": "^6.21.0",
    "next": "^15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "mongodb-memory-server": "^10.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
